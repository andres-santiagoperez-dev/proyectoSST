{
  "name": "safepulse-sst-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Suite de 3 aplicativos independientes de Seguridad y Salud en el Trabajo para Colombia (SafePulse SST)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:portal": "npm run dev --workspace=portal-empresa",
    "dev:pausas": "npm run dev --workspace=pausas-vitales",
    "dev:admin": "npm run dev --workspace=admin-sgsst",
    "start:portal": "npm run start --workspace=portal-empresa",
    "start:pausas": "npm run start --workspace=pausas-vitales",
    "start:admin": "npm run start --workspace=admin-sgsst",
    "build:portal": "npm run build --workspace=portal-empresa",
    "build:pausas": "npm run build --workspace=pausas-vitales",
    "build:admin": "npm run build --workspace=admin-sgsst",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
